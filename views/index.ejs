<%- include('partials/header.ejs') %>
<%- include('partials/navbarindex.ejs') %>
<body>
    <div class="container">
        <h1>Olá!</h1>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Categoria</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% articles.forEach(article => { %>
                    <tr>
                        <th><%= article.title %></th>
                        <th><%= article.category ? article.category.title : "Sem categoria" %></th>
                        <th>
                            <a class="btn btn-success" href="/<%= article.slug %>">Ler</a>
                        </th>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
<%- include('partials/footer.ejs') %>