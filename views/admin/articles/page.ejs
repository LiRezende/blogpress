<%- include('../../partials/header.ejs') %>
<%- include('../../partials/navbarindex.ejs') %>
<body>
    <div class="container">
        <h1>Olá!</h1>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Categoria</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% result.articles.rows.forEach(article => { %>
                    <tr>
                        <th><%= article.title %></th>
                        <th><%= article.categoryId ? article.category.title : "Sem categoria" %></th>
                        <th>
                            <a class="btn btn-success" href="/<%= article.slug %>">Ler</a>
                        </th>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        <div class="row">
            <hr>
            <div class="col col-12">
                <% if(result.next > 2) { %>
                    <a style="float: left;" href="<%= result.page - 1 %>">< Back</a>
                <% } %>

                <% if(result.next) { %>
                    <a style="float: right;" href="<%= result.page + 1 %>">Next ></a>
                <% } %>
            </div>
            <hr>
        </div>
    </div>
</body>
<%- include('../../partials/footer.ejs') %>